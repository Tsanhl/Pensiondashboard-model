# Server
PORT=3000
AUTHENTICATED_USER_ID=alex-morgan
REQUIRE_AUTH=false
REQUIRE_2FA=true
SESSION_TTL_MS=28800000
AUTH_LOCKOUT_MS=900000
AUTH_MAX_FAILED_LOGINS=5
PENSIONS_STORAGE=sqlite
DATABASE_URL=
AGENT_SCHEDULER_ENABLED=true
AGENT_SCHEDULER_INTERVAL_MS=300000

# Sole answer model: a self-hosted Qwen3-8B endpoint.
MODEL_RUNTIME=llama.cpp
LOCAL_LLM_TRANSPORT=openai
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=qwen3-8b-pension
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_MAX_TOKENS=320
# For the explicitly pinned local MLX adapter runtime (npm run model:serve:pinned),
# set LOCAL_LLM_MODEL to the checkpoint model-version + step, and BOTH hashes.
# The default llama.cpp endpoint above is a separate, base-only runtime.
LOCAL_LLM_EXPECTED_ADAPTER_SHA256=
LOCAL_LLM_EXPECTED_BASE_SHA256=
LOCAL_LLM_EXPECTED_ADAPTER_CONFIG_SHA256=
LOCAL_LLM_EXPECTED_CHECKPOINT_SHA256=
LLM_CONTEXT_SOURCE_LIMIT=6
LLM_SOURCE_SNIPPET_CHARS=1800

# Local English embedding service. The deterministic fallback is test-only.
EMBEDDING_SERVICE_URL=http://127.0.0.1:8090
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PENSION_RETRIEVAL_DEVICE=cpu
PENSION_RETRIEVAL_THREADS=2
ALLOW_DEGRADED_EMBEDDINGS=true
RETRIEVAL_MIN_SCORE=0.18
DEGRADED_RETRIEVAL_MIN_SCORE=0.04

# Cross-encoder reranking. Point this at the same local ML service below.
RERANK_SERVICE_URL=http://127.0.0.1:8090
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TIMEOUT_MS=20000
REQUIRE_CROSS_ENCODER_RERANK=false

# Readiness is intentionally stricter than local UI availability. A release-ready
# runtime must use the pinned model, live embedding/reranking services and the
# approved-corpus manifest described in README.md.
READINESS_DEPENDENCY_TIMEOUT_MS=3000
READINESS_CACHE_TTL_MS=5000
APPROVED_CORPUS_MANIFEST_PATH=
APPROVED_CORPUS_MANIFEST_SHA256=
APPROVED_CORPUS_MIN_DOCUMENTS=1
APPROVED_CORPUS_BOOTSTRAP_ON_START=false

# Redacted JSONL diagnostic logs are written to Logging/YYYY-MM-DD/.
LOGGING_ROOT=Logging
LOG_TIMEZONE=Asia/Hong_Kong
DEBUG_LOG_INCLUDE_TEXT=false

# Approved-material change events, freshness, and retrieval coverage alerts.
MATERIAL_WEBHOOK_SECRET=change-me-local-only
MATERIAL_WORKER_INTERVAL_MS=5000
FRESHNESS_MONITOR_INTERVAL_MS=3600000
RETRIEVAL_NO_RESULT_ALERT_RATE=0.25
HUMAN_SUPPORT_EMAIL=

# Redis accelerates hot conversation and retrieval state; Postgres remains authoritative.
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible object storage (MinIO values match infra/docker-compose.yml).
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_DIR=uploads/objects
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=pension-documents
S3_ACCESS_KEY_ID=pensions-local
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_UPLOAD_QUOTA=100
OCR_SERVICE_URL=
MALWARE_SCAN_URL=
MALWARE_SCAN_HEALTH_URL=
REQUIRE_MALWARE_SCAN=false

# Optional email alerts. The notification email entered in Settings is the destination.
# Configure one provider here or in your host environment. Do not commit real keys.
EMAIL_FROM="Pension Plan <alerts@example.com>"
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EMAIL_WEBHOOK_URL=
